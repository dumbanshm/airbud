# Copy to .env and fill in. See README for where each value comes from.

# Public URL of this server. Must be HTTPS for a phone (use a tunnel, see README).
PUBLIC_URL=http://localhost:8000

# Google Cloud → APIs & Services → Credentials → OAuth client ID (type: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SYNC_INTERVAL_MINUTES=15
DEMO_MODE=true
