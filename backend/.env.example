# Copy to .env and fill in. See README for where each value comes from.

# Where Google sends the browser after sign-in: the static relay page in docs/oauth.html, served
# by GitHub Pages. It hands the code back to the app, so this server never needs to be public.
GOOGLE_REDIRECT_URI=https://YOUR-GITHUB-USER.github.io/airbud/oauth.html

# Only needed if you skip the relay and let Google call this server directly (needs real HTTPS).
PUBLIC_URL=http://localhost:8000

# Google Cloud → APIs & Services → Credentials → OAuth client ID (type: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SYNC_INTERVAL_MINUTES=15
DEMO_MODE=true
